{
 "id": "write-your-method",
 "title": "Write down your method and turn it into a workflow you can run",
 "skill": "skills/write-your-method",
 "snapshot": [
  "tools/generate.py",
  "tools/check_generated.py",
  "tools/register.py",
  "tools/rename.py",
  "tools/make_case.py",
  "tools/overview.py"
 ],
 "steps": [
  {
   "id": "describe",
   "title": "What you want from it, and how you do it now",
   "instructions": "skills/write-your-method/SKILL.md#1-describe",
   "artifacts": [
    "steps/1-method.md"
   ],
   "gates": [
    {
     "type": "sections",
     "file": "steps/1-method.md",
     "headings": [
      {
       "title": "Core",
       "min_chars": 20
      },
      {
       "title": "How I do it",
       "min_items": 2
      },
      {
       "title": "Where it goes wrong"
      },
      {
       "title": "Where I decide"
      }
     ]
    },
    {
     "type": "user"
    }
   ]
  },
  {
   "id": "check",
   "title": "Look for something that already does it",
   "instructions": "skills/write-your-method/SKILL.md#2-check",
   "artifacts": [
    "steps/2-check.md"
   ],
   "gates": [
    {
     "type": "sections",
     "file": "steps/2-check.md",
     "headings": [
      {
       "title": "Existing tools"
      },
      {
       "title": "Choice",
       "min_items": 1,
       "max_items": 1
      }
     ]
    },
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "check",
      "{run}"
     ]
    },
    {
     "type": "user"
    }
   ]
  },
  {
   "id": "design",
   "title": "Your method back to you, suggestions, then the steps",
   "instructions": "skills/write-your-method/SKILL.md#3-design",
   "artifacts": [
    "steps/3-review.md",
    "steps/3-steps.json"
   ],
   "gates": [
    {
     "type": "sections",
     "file": "steps/3-review.md",
     "headings": [
      {
       "title": "Your method",
       "min_items": 2
      },
      {
       "title": "Suggestions"
      }
     ]
    },
    {
     "type": "json",
     "file": "steps/3-steps.json",
     "schema": {
      "type": "object",
      "required": [
       "name",
       "title",
       "steps"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "steps": {
        "type": "array",
        "minItems": 2,
        "maxItems": 12,
        "items": {
         "type": "object",
         "required": [
          "id",
          "title",
          "do",
          "deliver",
          "user"
         ],
         "properties": {
          "id": {
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "do": {
           "type": "string"
          },
          "deliver": {
           "type": "string"
          },
          "user": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    },
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "design",
      "{run}"
     ]
    },
    {
     "type": "user"
    }
   ]
  },
  {
   "id": "build",
   "title": "Build the workflow and put it in your library",
   "instructions": "skills/write-your-method/SKILL.md#4-build",
   "artifacts": [
    "generated/**",
    "steps/4-register.json"
   ],
   "gates": [
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "build",
      "{run}"
     ]
    },
    {
     "type": "json",
     "file": "steps/4-register.json",
     "schema": {
      "type": "object",
      "required": [
       "name",
       "library_path",
       "digest"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "library_path": {
        "type": "string"
       },
       "digest": {
        "type": "string",
        "minLength": 64
       }
      }
     }
    },
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "register",
      "{run}"
     ]
    }
   ]
  },
  {
   "id": "try",
   "title": "Run your new workflow once",
   "instructions": "skills/write-your-method/SKILL.md#5-try",
   "artifacts": [
    "steps/5-try.json"
   ],
   "gates": [
    {
     "type": "json",
     "file": "steps/5-try.json",
     "schema": {
      "type": "object",
      "required": [
       "run",
       "check"
      ],
      "properties": {
       "run": {
        "type": "string"
       },
       "check": {
        "type": "string",
        "enum": [
         "PASS"
        ]
       }
      }
     }
    },
    {
     "type": "user"
    }
   ]
  },
  {
   "id": "name",
   "title": "Its final name, and a case page if you want one",
   "instructions": "skills/write-your-method/SKILL.md#6-name",
   "artifacts": [
    "steps/6-name.json",
    "named/**",
    "steps/6-case.json",
    "steps/6-lessons.md",
    "case/**"
   ],
   "gates": [
    {
     "type": "json",
     "file": "steps/6-name.json",
     "schema": {
      "type": "object",
      "required": [
       "name"
      ],
      "properties": {
       "name": {
        "type": "string"
       }
      }
     }
    },
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "name",
      "{run}"
     ]
    },
    {
     "type": "json",
     "file": "steps/6-case.json",
     "schema": {
      "type": "object",
      "required": [
       "made"
      ],
      "properties": {
       "made": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "type": "command",
     "argv": [
      "python3",
      "{wf}/tools/check_generated.py",
      "case",
      "{run}"
     ]
    },
    {
     "type": "user"
    }
   ]
  }
 ]
}
